{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "district": {
      "type": "string"
    },
    "days": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "daily": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "fire_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "frp_sum_mw": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "date",
          "fire_count",
          "frp_sum_mw"
        ],
        "additionalProperties": false
      }
    },
    "trend_pct": {
      "type": "number"
    }
  },
  "required": [
    "district",
    "days",
    "daily",
    "trend_pct"
  ],
  "additionalProperties": false
}
