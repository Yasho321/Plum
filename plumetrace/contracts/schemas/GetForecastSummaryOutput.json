{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T\\d{2}Z$"
    },
    "issued_at": {
      "type": "string",
      "pattern": "Z$"
    },
    "model_version": {
      "type": "string"
    },
    "max_pm25": {
      "type": "number",
      "minimum": 0
    },
    "max_pm25_p10": {
      "type": "number",
      "minimum": 0
    },
    "max_pm25_p90": {
      "type": "number",
      "minimum": 0
    },
    "peak_window_utc": {
      "type": "array",
      "prefixItems": [
        {
          "type": "string",
          "pattern": "Z$"
        },
        {
          "type": "string",
          "pattern": "Z$"
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "delhi_fire_share_p10": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "delhi_fire_share_p50": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "delhi_fire_share_p90": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "hotspot_districts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "district": {
            "type": "string"
          },
          "share": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "share_p10": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "share_p90": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "trend_7d": {
            "type": "number"
          }
        },
        "required": [
          "district",
          "share",
          "share_p10",
          "share_p90",
          "trend_7d"
        ],
        "additionalProperties": false
      }
    },
    "hotspot_villages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "district": {
            "type": "string"
          },
          "h3": {
            "type": "string"
          },
          "lat": {
            "type": "number"
          },
          "lon": {
            "type": "number"
          },
          "fire_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "name",
          "district",
          "h3",
          "lat",
          "lon",
          "fire_count"
        ],
        "additionalProperties": false
      }
    },
    "degraded": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stations_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "cells_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "run_id",
    "issued_at",
    "model_version",
    "max_pm25",
    "max_pm25_p10",
    "max_pm25_p90",
    "peak_window_utc",
    "delhi_fire_share_p10",
    "delhi_fire_share_p50",
    "delhi_fire_share_p90",
    "hotspot_districts",
    "hotspot_villages",
    "degraded",
    "stations_count",
    "cells_count"
  ],
  "additionalProperties": false
}
