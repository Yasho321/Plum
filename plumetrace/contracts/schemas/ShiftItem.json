{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "pk": {
      "type": "string",
      "pattern": "^fleet#"
    },
    "sk": {
      "type": "string",
      "pattern": "^rider#"
    },
    "fleet_id": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "rider_id": {
      "type": "string"
    },
    "planned_stops": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "order_id": {
            "type": "string"
          },
          "h3": {
            "type": "string",
            "pattern": "^[0-9a-f]{15,16}$"
          },
          "eta": {
            "type": "string",
            "pattern": "Z$"
          }
        },
        "required": [
          "order_id",
          "h3",
          "eta"
        ],
        "additionalProperties": false
      }
    },
    "forecast_dose_ug": {
      "type": "number",
      "minimum": 0
    },
    "actual_dose_ug": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "plan_version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "pk",
    "sk",
    "fleet_id",
    "date",
    "rider_id",
    "planned_stops",
    "forecast_dose_ug",
    "actual_dose_ug",
    "plan_version"
  ],
  "additionalProperties": false
}
