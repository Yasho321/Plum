{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "order_id": {
      "type": "string"
    },
    "h3": {
      "type": "string",
      "pattern": "^[0-9a-f]{3,16}$"
    },
    "eta": {
      "type": "string",
      "pattern": "Z$"
    }
  },
  "required": [
    "order_id",
    "h3",
    "eta"
  ],
  "additionalProperties": false
}
