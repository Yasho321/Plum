{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "districts": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "language": {
      "type": "string",
      "enum": [
        "pa",
        "hi"
      ]
    },
    "max_villages": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    }
  },
  "required": [
    "districts",
    "language",
    "max_villages"
  ],
  "additionalProperties": false
}
