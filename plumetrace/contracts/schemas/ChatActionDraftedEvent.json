{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "action_drafted"
    },
    "action_id": {
      "type": "string"
    },
    "action_type": {
      "type": "string",
      "enum": [
        "district_report",
        "farmer_alert",
        "shift_plan",
        "rider_notify"
      ]
    },
    "preview_url": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "type",
    "action_id",
    "action_type"
  ],
  "additionalProperties": false
}
