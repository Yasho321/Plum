{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "pk": {
      "type": "string",
      "pattern": "^date#"
    },
    "sk": {
      "type": "string",
      "pattern": "^district#"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "district": {
      "type": "string"
    },
    "share_p10": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "share_p50": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "share_p90": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "fire_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "frp_sum_mw": {
      "type": "number",
      "minimum": 0
    },
    "receptor_stations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "pk",
    "sk",
    "date",
    "district",
    "share_p10",
    "share_p50",
    "share_p90",
    "fire_count",
    "frp_sum_mw",
    "receptor_stations"
  ],
  "additionalProperties": false
}
