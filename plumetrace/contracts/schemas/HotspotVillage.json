  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "district": {
      "type": "string"
    },
    "h3": {
      "type": "string"
    },
    "lat": {
      "type": "number"
    },
    "lon": {
      "type": "number"
    },
    "fire_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
