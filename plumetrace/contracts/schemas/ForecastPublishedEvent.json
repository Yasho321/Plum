{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "source": {
      "type": "string",
      "const": "plumetrace.engine"
    },
    "detail-type": {
      "type": "string",
      "const": "forecast.published"
    },
    "detail": {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}T\\d{2}Z$"
        },
        "issued_at": {
          "type": "string",
          "pattern": "Z$"
        },
        "max_pm25": {
          "type": "number",
          "minimum": 0
        },
        "peak_window_utc": {
          "type": "array",
          "prefixItems": [
            {
              "type": "string",
              "pattern": "Z$"
            },
            {
              "type": "string",
              "pattern": "Z$"
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "delhi_fire_share_p50": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "hotspot_districts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "district": {
                "type": "string"
              },
              "share": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "district",
              "share"
            ],
            "additionalProperties": false
          }
        },
        "hotspot_villages": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "district": {
                "type": "string"
              },
              "h3": {
                "type": "string"
              },
              "lat": {
                "type": "number"
              },
              "lon": {
                "type": "number"
              },
              "fire_count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "name",
              "district",
              "h3",
              "lat",
              "lon",
              "fire_count"
            ],
            "additionalProperties": false
          }
        },
        "degraded": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "summary_s3": {
          "type": "string",
          "format": "starts_with",
          "pattern": "^s3:\\/\\/.*"
        },
        "model_version": {
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "issued_at",
        "max_pm25",
        "peak_window_utc",
        "delhi_fire_share_p50",
        "hotspot_districts",
        "hotspot_villages",
        "degraded",
        "summary_s3",
        "model_version"
      ],
      "additionalProperties": false
    },
    "id": {
      "type": "string"
    },
    "account": {
      "type": "string"
    },
    "time": {
      "type": "string",
      "pattern": "Z$"
    },
    "region": {
      "type": "string"
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "version": {
      "type": "string"
    }
  },
  "required": [
    "source",
    "detail-type",
    "detail"
  ],
  "additionalProperties": false
}
