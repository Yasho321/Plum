{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "action_id": {
      "type": "string"
    },
    "riders_changed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "dose_reduction_pct": {
      "type": "object",
      "properties": {
        "fleet_total": {
          "type": "number"
        },
        "worst_rider": {
          "type": "number"
        }
      },
      "required": [
        "fleet_total",
        "worst_rider"
      ],
      "additionalProperties": false
    },
    "extra_minutes": {
      "type": "object",
      "properties": {
        "average": {
          "type": "number"
        },
        "total": {
          "type": "number"
        }
      },
      "required": [
        "average",
        "total"
      ],
      "additionalProperties": false
    },
    "solver": {
      "type": "string",
      "enum": [
        "cpsat",
        "greedy"
      ]
    }
  },
  "required": [
    "action_id",
    "riders_changed",
    "dose_reduction_pct",
    "extra_minutes",
    "solver"
  ],
  "additionalProperties": false
}
