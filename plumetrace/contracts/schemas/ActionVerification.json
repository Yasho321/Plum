{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "checked_at": {
          "type": "string",
          "pattern": "Z$"
        },
        "summary": {
          "type": "string"
        },
        "metrics": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "number"
          }
        }
      },
      "required": [
        "checked_at",
        "summary"
      ],
      "additionalProperties": false
    },
    {
      "type": "null"
    }
  ]
}
