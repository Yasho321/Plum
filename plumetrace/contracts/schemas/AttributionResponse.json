{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T\\d{2}Z$"
    },
    "districts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "district": {
            "type": "string"
          },
          "share_p10": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "share_p50": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "share_p90": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "fire_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "frp_sum_mw": {
            "type": "number",
            "minimum": 0
          },
          "trend_7d": {
            "type": "number"
          },
          "receptor_stations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "district",
          "share_p10",
          "share_p50",
          "share_p90",
          "fire_count",
          "frp_sum_mw",
          "trend_7d",
          "receptor_stations"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "date",
    "run_id",
    "districts"
  ],
  "additionalProperties": false
}
