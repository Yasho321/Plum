{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "rider_id": {
      "type": "string"
    },
    "erased": {
      "type": "boolean",
      "const": true
    },
    "erased_at": {
      "type": "string",
      "pattern": "Z$"
    }
  },
  "required": [
    "rider_id",
    "erased",
    "erased_at"
  ],
  "additionalProperties": false
}
