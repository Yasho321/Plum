{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "fleet_id": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "generated_at": {
      "type": "string",
      "pattern": "Z$"
    },
    "simulated": {
      "type": "boolean",
      "const": true
    },
    "summary": {
      "type": "object",
      "properties": {
        "riders_total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "riders_over_budget": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "worst_rider_pct": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "riders_total",
        "riders_over_budget",
        "worst_rider_pct"
      ],
      "additionalProperties": false
    },
    "riders": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rider_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "home_h3": {
            "type": "string",
            "pattern": "^[0-9a-f]{3,16}$"
          },
          "shift_hours": {
            "type": "number",
            "minimum": 0
          },
          "budget_ug": {
            "type": "number",
            "minimum": 0
          },
          "forecast_dose_ug": {
            "type": "number",
            "minimum": 0
          },
          "forecast_dose_pct": {
            "type": "number",
            "minimum": 0
          },
          "actual_dose_ug": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "actual_dose_pct": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "over_budget": {
            "type": "boolean"
          }
        },
        "required": [
          "rider_id",
          "name",
          "home_h3",
          "shift_hours",
          "budget_ug",
          "forecast_dose_ug",
          "forecast_dose_pct",
          "actual_dose_ug",
          "actual_dose_pct",
          "over_budget"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "fleet_id",
    "date",
    "generated_at",
    "simulated",
    "summary",
    "riders"
  ],
  "additionalProperties": false
}
