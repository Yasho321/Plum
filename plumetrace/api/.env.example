# OWNER    : Yasho2
# DUE      : D1 14:00
# TASK     :
#   Every var from env.js with dummy values. MOCK_MODE=1 by default.
# DONE WHEN: -
# GUIDE    : docs/team/YASHO2.md  |  brief: docs/PROJECT_BRIEF.md
# STATUS   : DONE
#
# Copy to .env for local dev. NEVER commit real secrets or a real .env
# (keys live in AWS Secrets Manager; see CLAUDE.md).

NODE_ENV=development
PORT=8080

# 1 = serve contracts/mocks, no AWS needed. Set 0 only with the vars below filled.
MOCK_MODE=1
AWS_REGION=us-east-1

# Comma-separated allowed browser origins (Amplify URL + local Vite)
CORS_ORIGINS=http://localhost:5173

# DynamoDB tables (brief §8.1) — Tejas's DataStack outputs the real names
TABLE_FORECAST=pt-dev-Forecast
TABLE_STATION_FORECAST=pt-dev-StationForecast
TABLE_ATTRIBUTION=pt-dev-Attribution
TABLE_ACTIONS=pt-dev-Actions
TABLE_RIDERS=pt-dev-Riders
TABLE_RIDER_HEALTH=pt-dev-RiderHealth
TABLE_SHIFTS=pt-dev-Shifts
TABLE_ROUTE_CACHE=pt-dev-RouteCache

# S3 + EventBridge
BUCKET=pt-dev-bucket
BUS_NAME=plumetrace

# Cognito (required when MOCK_MODE=0) — from Tejas's ApiStack
COGNITO_POOL_ID=us-east-1_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Bedrock Copilot — use EXACTLY the id the console shows (often an inference profile)
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
GUARDRAIL_ID=
GUARDRAIL_VERSION=DRAFT

# Tool Lambda names/ARNs (Khare's gov Lambdas + Yasho2's re-planner)
FN_REPORT=
FN_FARMER_ALERT=
FN_FIRE_TREND=
FN_REPLANNER=
FN_RIDER_NOTIFY=
